{
  "name": "driverlink-rules-tests",
  "private": true,
  "description": "Pruebas de firestore.rules y storage.rules con el emulador de Firebase.",
  "scripts": {
    "test": "node --test --test-concurrency=1 *.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-driverlink --only firestore,storage \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
