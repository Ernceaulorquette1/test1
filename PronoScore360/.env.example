# Copia este archivo a .env y ajusta. NUNCA subas .env a Git. Aquí NO hay credenciales reales.

# ---------- Entorno ----------
ENV=local                       # local | test | staging | production
# Producción: JWT_SECRET (>=32 caracteres aleatorios), REDIS_URL y PAYMENTS_PROVIDER=none son OBLIGATORIOS.

# ---------- Base de datos / caché ----------
POSTGRES_USER=pronoscore
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_DB=pronoscore
DATABASE_URL=postgresql+psycopg://pronoscore:cambia_esta_clave_local@db:5432/pronoscore
REDIS_URL=redis://redis:6379/0

# ---------- Seguridad ----------
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Datos deportivos ----------
PROVIDER_MODE=demo              # demo = datos ficticios | real = API-SPORTS (requiere claves)
APIFOOTBALL_KEY=                # clave de API-Football (dashboard.api-sports.io). Sólo en el backend.
APINBA_KEY=                     # clave de API-NBA
PROVIDER_DAILY_BUDGET=100       # tope propio de peticiones/día por proveedor (ajústalo a tu plan)
PROVIDER_RESERVE=10             # reserva para peticiones interactivas

# ---------- Pagos ----------
PAYMENTS_PROVIDER=demo          # demo (sólo local/test) | none
GOOGLE_PLAY_PACKAGE_NAME=com.pronoscore360.app
GOOGLE_PLAY_PRODUCT_ID=pronoscore360_pro_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=      # ruta a un archivo JSON (montado como secreto) o el JSON completo
GOOGLE_PLAY_RTDN_AUDIENCE=             # URL del endpoint push configurada en Pub/Sub
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=      # email de la cuenta que firma el push de Pub/Sub

# ---------- Cuentas ----------
GOOGLE_CLIENT_ID=               # ID de cliente OAuth (Web) para iniciar sesión con Google
FRONTEND_URL=http://localhost:5173
SMTP_HOST=                      # vacío = los correos sólo se registran en el log (únicamente local)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pronoscore360.example

# ---------- Tareas programadas ----------
SCHEDULER_ENABLED=true          # true en UN solo proceso (worker) si hay varias réplicas
SEED_DEMO_ON_START=true         # sólo local/test: crea datos ficticios y cuentas demo
DEMO_ACCOUNTS_ENABLED=true      # se fuerza a false fuera de local/test

# ---------- Web ----------
VITE_API_URL=http://localhost:8000/api/v1
